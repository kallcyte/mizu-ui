{
  "name": "mizu-design-system",
  "type": "module",
  "version": "0.17.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm --filter @mizu/tokens build && node scripts/clear-astro-cache.mjs && concurrently --names vue,astro,cache -c green,magenta,yellow \"pnpm --filter @mizu/vue dev\" \"astro dev\" \"node scripts/clear-astro-cache.mjs --watch\"",
    "build": "node -e \"fs.rmSync('.astro',{recursive:true,force:true})\" && cross-env CI=true nx run-many -t build && astro build",
    "dev:tokens": "nx run @mizu/tokens:dev",
    "build:tokens": "nx run @mizu/tokens:build",
    "dev:vue": "nx run @mizu/vue:dev",
    "build:vue": "nx run @mizu/vue:build",
    "dev:docs": "astro dev",
    "build:docs": "astro build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"fs.rmSync('.astro',{recursive:true,force:true})\" && nx run-many -t clean",
    "preview": "astro preview",
    "dev:bg": "nx run @mizu/vue:build && astro dev stop && astro dev --background"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/starlight": "^0.41.3",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vue": "^7.0.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@internationalized/date": "^3.12.2",
    "@mizu/tokens": "workspace:*",
    "@mizu/vue": "workspace:*",
    "@nuxt/kit": "^4.0.0",
    "@nuxt/ui": "^4.9.0",
    "astro": "^7.0.6",
    "better-sqlite3": "^12.10.0",
    "maska": "^3.2.0",
    "shiki": "^4.3.1",
    "vue": "^3.5.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "nx": "^23.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript-eslint": "^8.63.0"
  }
}
