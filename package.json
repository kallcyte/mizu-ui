{
  "name": "mizu-design-system",
  "type": "module",
  "version": "0.15.1",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "cross-env CI=true node_modules/.bin/nx run-many -t build && node -e \"fs.rmSync('.astro',{recursive:true,force:true})\" && concurrently --names vue,astro -c green,magenta \"pnpm --filter @mizu/vue dev\" \"astro dev\"",
    "build": "node -e \"fs.rmSync('.astro',{recursive:true,force:true})\" && cross-env CI=true node_modules/.bin/nx run-many -t build && astro build",
    "build:tokens": "pnpm --filter @mizu/tokens build",
    "build:vue": "pnpm --filter @mizu/vue build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.1",
    "@astrojs/vue": "^7.0.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.22.0",
    "@mizu/tokens": "workspace:*",
    "@mizu/vue": "workspace:*",
    "astro": "^7.0.4",
    "better-sqlite3": "^12.10.0",
    "reka-ui": "^2.10.1",
    "shiki": "^4.3.0",
    "vue": "^3.5.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "nx": "^23.0.1",
    "tailwindcss": "^4.3.2"
  }
}
