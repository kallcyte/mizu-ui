---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blueprint · Design System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="fixed top-0 left-0 right-0 z-100 bg-white/92 backdrop-blur-xl border-b border-surface-muted">
    <div class="container flex items-center justify-between h-14">
      <a href="#" class="font-bold text-lg tracking-tight no-underline text-brand-primary">
        Blueprint<span class="text-brand-accent">.</span>
      </a>
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-6 max-md:hidden">
          <a href="#color" class="nav-link text-sm font-medium no-underline">Color</a>
          <a href="#typography" class="nav-link text-sm font-medium no-underline">Type</a>
          <a href="#spacing" class="nav-link text-sm font-medium no-underline">Spacing</a>
          <a href="#components" class="nav-link text-sm font-medium no-underline">Components</a>
          <a href="#diagrams" class="nav-link text-sm font-medium no-underline">Diagrams</a>
        </div>
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-accent-subtle text-brand-accent">v1.0.0</span>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <script is:inline src="./faq.js" defer></script>

  <footer class="py-xl bg-brand-primary text-foreground-inverse">
    <div class="container flex justify-between items-center flex-wrap gap-4">
      <div class="text-xl font-bold tracking-tight">Blueprint.</div>
      <div class="flex gap-6 text-sm">
        <a href="https://github.com" target="_blank" class="text-white/70 no-underline hover:text-white">GitHub</a>
        <a href="#" class="text-white/70 no-underline hover:text-white">Tokens</a>
        <a href="#" class="text-white/70 no-underline hover:text-white">Docs</a>
        <a href="#" class="text-white/70 no-underline hover:text-white">Components</a>
      </div>
      <div class="text-xs text-white/50">
        Precision foundations for coherent interfaces.
      </div>
    </div>
  </footer>
</body>
</html>
