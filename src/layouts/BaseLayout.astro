---
import "../styles/global.css";
import "@mizu/vue/style.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mizu · Design System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="bg-surface-base text-foreground-primary transition-colors duration-200">
  <nav class="fixed top-0 left-0 right-0 z-100 bg-surface-base/92 backdrop-blur-xl border-b border-surface-muted">
    <div class="container flex items-center justify-between h-14">
      <a href="/" class="font-bold text-lg tracking-tight no-underline text-brand-primary">
              Mizu<span class="text-foreground-primary">.</span>
            </a>
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-6 max-md:hidden">
          <a href="#color" class="nav-link text-sm font-medium no-underline">Color</a>
          <a href="#typography" class="nav-link text-sm font-medium no-underline">Type</a>
          <a href="#spacing" class="nav-link text-sm font-medium no-underline">Spacing</a>
          <a href="/components" class="nav-link text-sm font-medium no-underline">Components</a>
          <a href="/demo/login" class="nav-link text-sm font-medium no-underline">Demo</a>
          <a href="#diagrams" class="nav-link text-sm font-medium no-underline">Diagrams</a>
        </div>
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-primary text-white">v0.18.24</span>
        <a
          href="https://github.com/kallcyte/mizu-ui"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="inline-flex items-center justify-center size-7 rounded-full text-foreground-primary hover:bg-surface-muted transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <script is:inline src="./faq.js" defer></script>

  <footer class="py-xl bg-brand-ycp text-foreground-inverse">
    <div class="container flex justify-between items-center flex-wrap gap-4">
      <div class="text-xl font-bold tracking-tight">Mizu.</div>
      <div class="flex gap-6 text-sm">
        <a href="https://github.com" target="_blank" class="opacity-70 no-underline hover:opacity-100 transition-opacity">GitHub</a>
        <a href="#" class="opacity-70 no-underline hover:opacity-100 transition-opacity">Tokens</a>
        <a href="#" class="opacity-70 no-underline hover:opacity-100 transition-opacity">Docs</a>
        <a href="#" class="opacity-70 no-underline hover:opacity-100 transition-opacity">Components</a>
      </div>
      <div class="text-xs opacity-50">
        Precision foundations for coherent interfaces.
      </div>
    </div>
  </footer>
</body>
</html>
