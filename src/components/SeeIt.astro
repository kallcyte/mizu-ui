---
import SectionHeader from "./SectionHeader.astro";
---

<section>
  <div class="container">
    <SectionHeader num="00" title="See it" sub="Output samples built from the same constraint set — one token system, three distinct products." />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <article class="flex max-md:flex-col gap-6 p-6 rounded-2xl border items-start transition-shadow duration-200 card-hover-lg border-surface-muted bg-surface-base">
        <div class="flex-1">
          <h4 class="text-[17px] font-semibold mb-1.5">Hub Design System</h4>
          <p class="text-sm mb-3 text-fg-secondary">Complete token documentation, component library, and usage guidelines. Single-page reference for designers and engineers.</p>
          <div class="flex gap-2 flex-wrap">
            <span class="tag tag-accent">Reference</span>
            <span class="tag tag-muted">1 page</span>
          </div>
        </div>
        <div class="w-[120px] h-[120px] rounded-xl shrink-0 flex items-center justify-center max-md:w-full max-md:h-20 bg-brand-primary-subtle" style="font-size: 36px;">&#9670;</div>
      </article>
      <article class="flex max-md:flex-col gap-6 p-6 rounded-2xl border items-start transition-shadow duration-200 card-hover-lg border-surface-muted bg-surface-base">
        <div class="flex-1">
          <h4 class="text-[17px] font-semibold mb-1.5">Landing Page</h4>
          <p class="text-sm mb-3 text-fg-secondary">Product homepage built with the Blueprint system — consistent spacing, brand-first palette, clean typography.</p>
          <div class="flex gap-2 flex-wrap">
            <span class="tag tag-accent">Marketing</span>
            <span class="tag tag-muted">Responsive</span>
          </div>
        </div>
        <div class="w-[120px] h-[120px] rounded-xl shrink-0 flex items-center justify-center max-md:w-full max-md:h-20 bg-brand-primary-subtle" style="font-size: 36px;">&#9632;</div>
      </article>
    </div>
  </div>
</section>
