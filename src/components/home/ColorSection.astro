const feedbacksDark: ColorCard[] = [
  { hex: "#4ADE80", name: "Success Base", desc: "Lighter green for success on dark backgrounds." },
  { hex: "#86EFAC", name: "Success Hover", desc: "Lighter success hover on dark backgrounds." },
  { hex: "#BBF7D0", name: "Success Focus", desc: "Lightest success focus on dark backgrounds." },
  { hex: "#14532D", name: "Success Subtle", desc: "Dark success background for banners on dark." },
  { hex: "#F87171", name: "Error Base", desc: "Lighter red for errors on dark backgrounds." },
  { hex: "#FCA5A5", name: "Error Hover", desc: "Lighter error hover on dark backgrounds." },
  { hex: "#FECACA", name: "Error Focus", desc: "Lightest error focus on dark backgrounds." },
  { hex: "#7F1D1D", name: "Error Subtle", desc: "Dark error background for banners on dark." },
  { hex: "#FBBF24", name: "Warning Base", desc: "Lighter amber for warnings on dark backgrounds." },
  { hex: "#FCD34D", name: "Warning Hover", desc: "Lighter warning hover on dark backgrounds." },
  { hex: "#FDE68A", name: "Warning Focus", desc: "Lightest warning focus on dark backgrounds." },
  { hex: "#78350F", name: "Warning Subtle", desc: "Dark amber background for warning banners on dark." },
  { hex: "#38BDF8", name: "Info Base", desc: "Lighter sky for info on dark backgrounds." },
  { hex: "#7DD3FC", name: "Info Hover", desc: "Lighter info hover on dark backgrounds." },
  { hex: "#BAE6FD", name: "Info Focus", desc: "Lightest info focus on dark backgrounds." },
  { hex: "#1E3A5F", name: "Info Subtle", desc: "Dark sky background for info banners on dark." },
