---
import SectionHeader from "./SectionHeader.astro";

interface ColorCard {
  hex: string;
  name: string;
  desc: string;
  border?: boolean;
}

const Hubs: ColorCard[] = [
  { hex: "#001C44", name: "YCP", desc: "Deep navy YCP for emphasis, dark Hubed surfaces, and hero sections." },
  { hex: "#0070F2", name: "Primary", desc: "Primary hub blue for buttons, links, and key interactive elements." },
  { hex: "#1524A9", name: "Secondary", desc: "Supporting hub blue for charts and secondary emphasis." },
  { hex: "#EDF0FF", name: "Muted", desc: "Soft hub-tinted surface for subtle highlights and selected rows." },
  { hex: "#1B1B1D", name: "Neutral", desc: "Deep neutral for high-contrast text and key borders." },
  { hex: "#005AC2", name: "Primary Hover", desc: "Darker hover state for primary-filled buttons and interactive elements." },
  { hex: "#338DF5", name: "Primary Focus", desc: "Focus ring and outline state for primary interactive elements." },
  { hex: "#CCE2FC", name: "Primary Subtle", desc: "Light primary-tinted background for selected states and highlights." },
  { hex: "#001636", name: "YCP Hover", desc: "Darker hover state for YCP-filled elements." },
  { hex: "#334969", name: "YCP Focus", desc: "Focus ring and outline state for YCP elements." },
  { hex: "#CCD2DA", name: "YCP Subtle", desc: "Light YCP-tinted background for subdued emphasis." },
  { hex: "#101C82", name: "Secondary Hover", desc: "Darker hover state for secondary hub fills." },
  { hex: "#0C1561", name: "Secondary Focus", desc: "Deepest secondary for focus-visible outlines and pressed states." },
  { hex: "#E1E7FF", name: "Secondary Subtle", desc: "Light surface counterpart for secondary Hubed backgrounds." },
  { hex: "#4521D8", name: "Nexus", desc: "Nexus purple for premium features, special emphasis, and distinctive UI elements." },
  { hex: "#371AAD", name: "Nexus Hover", desc: "Darker hover state for nexus-filled elements." },
  { hex: "#6A4DE0", name: "Nexus Focus", desc: "Focus ring and outline state for nexus elements." },
  { hex: "#DAD3F7", name: "Nexus Subtle", desc: "Light nexus-tinted background for subtle highlights." },
];

const HubsDark: ColorCard[] = [
  { hex: "#F1F5F9", name: "YCP (fg-primary)", desc: "Dark mode high-emphasis text (WCAG AA on #0F1117)." },
  { hex: "#338DF5", name: "Primary (scale-300)", desc: "Light primary for interactive states on dark. Matches focus token." },
  { hex: "#5A71F5", name: "Secondary (scale-300)", desc: "Light secondary for charts and emphasis on dark." },
  { hex: "#9BACFC", name: "Secondary (scale-200)", desc: "Lighter secondary variant for hover states on dark." },
  { hex: "#E1E7FF", name: "Secondary (scale-100)", desc: "Subtle secondary background on dark. Matches subtle token." },
  { hex: "#1E2030", name: "Muted (surface-muted)", desc: "Dark mode tertiary surface for subtle hub-tinted zones." },
  { hex: "#F1F5F9", name: "Neutral (fg-primary)", desc: "High-emphasis neutral text on dark backgrounds." },
  { hex: "#80B7F8", name: "Primary (scale-200)", desc: "Lighter primary hover for interactive elements on dark." },
  { hex: "#CCE2FC", name: "Primary (scale-100)", desc: "Light-tinted primary surface on dark. Matches subtle token." },
  { hex: "#758CAC", name: "YCP (scale-200)", desc: "Lighter YCP for hover states on dark." },
  { hex: "#334969", name: "YCP (scale-300)", desc: "YCP focus ring on dark. Matches focus token." },
  { hex: "#CCD2DA", name: "YCP (scale-100)", desc: "Subtle YCP background on dark. Matches subtle token." },
  { hex: "#A290EB", name: "Nexus (scale-200)", desc: "Lighter nexus for emphasis on dark backgrounds." },
  { hex: "#6A4DE0", name: "Nexus (scale-300)", desc: "Nexus focus ring on dark. Matches focus token." },
  { hex: "#5635DE", name: "Nexus (scale-400)", desc: "Nexus hover emphasis on dark." },
  { hex: "#DAD3F7", name: "Nexus (scale-100)", desc: "Subtle nexus background on dark. Matches subtle token." },
];

const backgrounds: ColorCard[] = [
  { hex: "#FFFFFF", name: "Base", desc: "Default page and card background. Highest-contrast surface.", border: true },
  { hex: "#F9FAFB", name: "Subtle", desc: "Secondary surface for grouped sections and side panels.", border: true },
  { hex: "#F3F4F6", name: "Muted", desc: "Tertiary surface for table rows and disabled zones.", border: true },
];

const backgroundsDark: ColorCard[] = [
  { hex: "#0F1117", name: "Base", desc: "Default page and card background on dark.", border: true },
  { hex: "#161822", name: "Subtle", desc: "Secondary surface for grouped sections on dark.", border: true },
  { hex: "#1E2030", name: "Muted", desc: "Tertiary surface for table rows on dark.", border: true },
];

const texts: ColorCard[] = [
  { hex: "#001C44", name: "Primary", desc: "Default high-emphasis text for titles and body copy." },
  { hex: "#4B5563", name: "Secondary", desc: "Supporting text for descriptions and metadata." },
  { hex: "#9CA3AF", name: "Tertiary", desc: "Low-emphasis text for placeholders and disabled content." },
  { hex: "#FFFFFF", name: "Inverse", desc: "Text on dark or saturated backgrounds — preserves legibility.", border: true },
];

const textsDark: ColorCard[] = [
