const scaleFamilies = [
  {
    name: "Primary",
    shades: [
      { hex: "#E8F2FE" },
      { hex: "#CCE2FC", match: "primary-subtle" },
      { hex: "#80B7F8" },
      { hex: "#338DF5", match: "primary-focus" },
      { hex: "#147EF9" },
      { hex: "#0070F2", match: "primary" },
      { hex: "#0065DA" },
      { hex: "#005AC2", match: "primary-hover" },
      { hex: "#004FAA" },
      { hex: "#004492" },
      { hex: "#003675" },
    ],
  },
  {
    name: "Secondary",
    shades: [
      { hex: "#F2F4FF" },
      { hex: "#E1E7FF", match: "secondary-subtle" },
      { hex: "#9BACFC" },
      { hex: "#5A71F5" },
      { hex: "#1C36EA" },
      { hex: "#1524A9", match: "secondary" },
      { hex: "#122096" },
      { hex: "#101C82", match: "secondary-hover" },
      { hex: "#0E1971" },
