const shadeLabels = ["50","100","200","300","400","500","600","700","800","900","950"];

function swatchStyle(c: ColorCard) {
  let s = `background: ${c.hex};`;
  if (c.border) s += 'border:1px solid var(--color-surface-muted);';
  return s;
}

function shadeSwatchStyle(hex: string) {
  return `background:${hex};`;
}
---

<section class="bg-surface-subtle" id="color">
  <div class="container">
    <SectionHeader num="03" title="Color" sub="Restrained palette. One navy primary, one blue accent, neutral grays. No second accent color." />

    <h3 class="text-lg font-semibold mb-2 mt-8 text-foreground-secondary">Hub</h3>
    <div class="color-grid color-light">
      {Hubs.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(255,255,255,0.85);">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="color-grid color-dark">
      {HubsDark.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(0,0,0,0.6); color: #FFFFFF;">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-lg font-semibold mb-2 mt-8 text-foreground-secondary">Background</h3>
    <div class="color-grid color-light">
      {backgrounds.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(255,255,255,0.85);">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="color-grid color-dark">
      {backgroundsDark.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(0,0,0,0.6); color: #FFFFFF;">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-lg font-semibold mb-2 mt-8 text-foreground-secondary">Text</h3>
    <div class="color-grid color-light">
      {texts.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(255,255,255,0.85);">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="color-grid color-dark">
      {textsDark.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(0,0,0,0.6); color: #FFFFFF;">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-lg font-semibold mb-2 mt-8 text-foreground-secondary">Feedback</h3>
    <div class="color-grid color-light">
      {feedbacks.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(255,255,255,0.85);">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="color-grid color-dark">
      {feedbacksDark.map(c => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="h-20 flex items-end p-2.5" style={swatchStyle(c)}>
            <span class="text-xs font-semibold px-2 py-0.5 rounded backdrop-blur font-mono" style="background: rgba(0,0,0,0.6); color: #FFFFFF;">{c.hex}</span>
          </div>
          <div class="p-3">
            <div class="text-sm font-semibold mb-1">{c.name}</div>
            <div class="text-xs leading-relaxed text-foreground-secondary">{c.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-lg font-semibold mb-2 mt-8 text-foreground-secondary">Scale (Nuxt UI)</h3>
    <p class="text-sm text-foreground-tertiary mb-4">Full 50–950 color ramps for Nuxt UI v4's component color pipeline. Each family has 11 shades.</p>
    <div class="color-grid" style="grid-template-columns:1fr;">
      {scaleFamilies.map(f => (
        <div class="rounded-xl overflow-hidden border border-surface-muted bg-surface-base">
          <div class="p-3 pb-2 flex items-center gap-3">
            <span class="text-sm font-semibold whitespace-nowrap min-w-16">{f.name}</span>
            <div class="flex flex-1 gap-1 overflow-x-auto">
              {f.shades.map((shade, i) => (
                <div class="flex-1 min-w-14 rounded-md overflow-hidden">
                  <div class="h-12 flex items-end justify-center p-1" style={shadeSwatchStyle(shade.hex)}>
                    <span class="text-[9px] font-mono font-semibold px-1 py-px rounded" style={`background:rgba(0,0,0,0.5);color:#fff;`}>{shade.hex}</span>
                  </div>
                  <div class="text-[10px] text-center text-foreground-tertiary mt-1 font-mono">{shadeLabels[i]}</div>
                  {shade.match && <div class="text-[9px] text-center text-hub-primary font-medium leading-tight mt-0.5">({shade.match})</div>}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style is:global>
  .color-dark { display: none; }
  [data-theme="dark"] .color-light { display: none; }
  [data-theme="dark"] .color-dark { display: grid; }
</style>
