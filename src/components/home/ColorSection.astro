const feedbacks: ColorCard[] = [
  { hex: "#15803D", name: "Success Base", desc: "Primary success for confirmed positive status and badges." },
  { hex: "#166534", name: "Success Hover", desc: "Darker hover for success-filled elements." },
  { hex: "#14532D", name: "Success Focus", desc: "Deepest success for focus-visible outlines." },
  { hex: "#DCFCE7", name: "Success Subtle", desc: "Light success background for banners and highlights." },
  { hex: "#DC2626", name: "Error Base", desc: "Primary error for critical statuses and destructive actions." },
  { hex: "#B91C1C", name: "Error Hover", desc: "Darker hover for error-filled elements." },
  { hex: "#991B1B", name: "Error Focus", desc: "Deepest error for focus-visible outlines." },
  { hex: "#FEF2F2", name: "Error Subtle", desc: "Light error background for error banners and toast backgrounds." },
  { hex: "#D97706", name: "Warning Base", desc: "Primary warning for caution states and pending indicators." },
  { hex: "#B45309", name: "Warning Hover", desc: "Darker hover for warning-filled elements." },
  { hex: "#92400E", name: "Warning Focus", desc: "Deepest warning for focus-visible outlines." },
