  { hex: "#0284C7", name: "Info Base", desc: "Primary info for on-progress and processing states." },
  { hex: "#0369A1", name: "Info Hover", desc: "Darker hover for info-filled elements." },
  { hex: "#075985", name: "Info Focus", desc: "Deepest info for focus-visible outlines." },
  { hex: "#F0F9FF", name: "Info Subtle", desc: "Light sky background for info banners." },
