---
import SectionHeader from "./SectionHeader.astro";
---

<section class="bg-surface-subtle">
  <div class="container">
    <SectionHeader num="01" title="Usage" sub="Install the packages you need and start building. Tokens, Vue components, and React components — pick your layer." />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="p-5 rounded-xl border bg-surface-base border-surface-muted">
        <div class="text-xs font-semibold uppercase tracking-widest mb-2 text-foreground-tertiary">Tokens</div>
        <code class="block text-sm p-2.5 rounded-md border break-all font-mono bg-surface-subtle border-surface-muted text-foreground-primary">npm install @mizu-ui/tokens</code>
        <p class="text-xs mt-2 text-foreground-tertiary">Colors, spacing, typography — framework-agnostic</p>
      </div>
      <div class="p-5 rounded-xl border bg-surface-base border-surface-muted">
        <div class="text-xs font-semibold uppercase tracking-widest mb-2 text-foreground-tertiary">Vue</div>
        <code class="block text-sm p-2.5 rounded-md border break-all font-mono bg-surface-subtle border-surface-muted text-foreground-primary">npm install @mizu-ui/vue</code>
        <p class="text-xs mt-2 text-foreground-tertiary">Reka UI primitives + Mizu styling</p>
      </div>
      <div class="p-5 rounded-xl border bg-surface-base border-surface-muted">
        <div class="text-xs font-semibold uppercase tracking-widest mb-2 text-foreground-tertiary">React</div>
        <code class="block text-sm p-2.5 rounded-md border break-all font-mono bg-surface-subtle border-surface-muted text-foreground-tertiary">npm install @mizu/react</code>
        <p class="text-xs mt-2 text-foreground-tertiary">shadcn/ui + ReUI — coming soon</p>
      </div>
    </div>
    <div class="p-5 rounded-lg border overflow-x-auto font-mono text-[12px] leading-[1.7] bg-surface-subtle border-surface-muted">
      <span class="text-foreground-tertiary">// Import tokens</span><br/>
      <span class="text-foreground-primary font-semibold">import</span> &#123; colors, spacing &#125; <span class="text-foreground-primary font-semibold">from</span> <span class="text-success-base">'@mizu-ui/tokens'</span>;<br/><br/>
      <span class="text-foreground-tertiary">// Import Vue components</span><br/>
      <span class="text-foreground-primary font-semibold">import</span> &#123; MizuButton, MizuInput &#125; <span class="text-foreground-primary font-semibold">from</span> <span class="text-success-base">'@mizu-ui/vue'</span>;<br/><br/>
      <span class="text-foreground-tertiary">// Use with Tailwind classes</span><br/>
      <span class="text-foreground-primary font-semibold">&lt;</span>MizuButton <span class="text-foreground-primary">variant</span>=<span class="text-success-base">"primary"</span><span class="text-foreground-primary font-semibold">&gt;</span>Get Started<span class="text-foreground-primary font-semibold">&lt;/</span>MizuButton<span class="text-foreground-primary font-semibold">&gt;</span>
    </div>
  </div>
</section>
