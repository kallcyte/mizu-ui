---
---

<section class="relative overflow-hidden pt-[140px] pb-xxl bg-surface-base">
  <div class="hero-gradient"></div>
  <div class="container relative">
    <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-6 text-foreground-tertiary">
      Design System &middot; v1.0.0 &middot; 2026.05
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-normal font-semibold bg-brand-accent-subtle text-brand-accent">EN</span>
    </div>
    <h1 class="font-extrabold tracking-tight leading-none mb-5 text-brand-primary" style="font-size: clamp(48px, 8vw, 80px);">
      Blueprint<span class="text-brand-accent">.</span>
    </h1>
    <p class="text-xl max-w-[640px] leading-relaxed mb-9 text-foreground-secondary">
      Precision foundations for building coherent interfaces. A constrained token system, one accent flow, and deliberate restraint.
    </p>
    <div class="hero-swatches hero-swatches--light flex flex-wrap gap-3 items-center p-5 rounded-xl border bg-surface-subtle border-surface-muted">
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-black/6" style="background: #001C44;"></span> Primary #001C44
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-black/6" style="background: #007FFF;"></span> Accent #007FFF
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-surface-muted" style="background: #FFFFFF;"></span> Canvas #FFFFFF
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-black/6" style="background: #1524A9;"></span> Secondary #1524A9
      </span>
    </div>
    <div class="hero-swatches hero-swatches--dark flex flex-wrap gap-3 items-center p-5 rounded-xl border bg-surface-subtle border-surface-muted">
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-white/10" style="background: #D6E4FF;"></span> Primary #D6E4FF
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-white/10" style="background: #60A5FA;"></span> Accent #60A5FA
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-white/10" style="background: #0F1117;"></span> Canvas #0F1117
      </span>
      <span class="text-xs text-foreground-tertiary">|</span>
      <span class="flex items-center gap-2 text-sm font-medium text-foreground-secondary">
        <span class="w-5 h-5 rounded-md shrink-0 border border-white/10" style="background: #93C5FD;"></span> Secondary #93C5FD
      </span>
    </div>
  </div>
</section>

<style is:global>
  .hero-swatches--dark { display: none; }
  [data-theme="dark"] .hero-swatches--light { display: none; }
  [data-theme="dark"] .hero-swatches--dark { display: flex; }
</style>
