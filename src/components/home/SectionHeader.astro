---
interface Props {
  num: string;
  title: string;
  sub?: string;
}

const { num, title, sub } = Astro.props;
---

<div class="flex items-baseline gap-4 mb-10">
  <span class="text-sm font-bold shrink-0 font-mono text-brand-accent tracking-snug">
    {num}
  </span>
  <h2 class="text-[28px] max-sm:text-[22px] font-bold text-brand-primary tracking-snug">
    {title}
  </h2>
</div>
{sub && (
  <p class="text-base mt-[-8px] mb-10 max-w-[600px] text-foreground-secondary">
    {sub}
  </p>
)}
