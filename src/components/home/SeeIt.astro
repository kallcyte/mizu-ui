---
import SectionHeader from "./SectionHeader.astro";
---

<section>
  <div class="container">
    <SectionHeader num="00" title="See it" sub="Output samples built from the same constraint set — one token system, three distinct products." />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <article class="flex max-md:flex-col gap-6 p-6 rounded-2xl border items-start transition-shadow duration-200 card-hover-lg border-surface-muted bg-surface-base">
        <div class="flex-1">
          <h4 class="text-[17px] font-semibold mb-1.5">Login</h4>
          <p class="text-sm mb-3 text-foreground-secondary">ERP authentication screen with form validation, error states, and brand-first layout. Exercises Input, Button, Checkbox, Alert, and Card components.</p>
          <div class="flex gap-2 flex-wrap">
            <span class="tag tag-accent">Sample Page</span>
            <span class="tag tag-muted">Login</span>
          </div>
        </div>
        <div class="w-[120px] h-[120px] rounded-xl shrink-0 flex items-center justify-center max-md:w-full max-md:h-20 bg-brand-primary-subtle" style="font-size: 36px;">&#9670;</div>
      </article>
      <article class="flex max-md:flex-col gap-6 p-6 rounded-2xl border items-start transition-shadow duration-200 card-hover-lg border-surface-muted bg-surface-base">
        <div class="flex-1">
          <h4 class="text-[17px] font-semibold mb-1.5">Dashboard</h4>
          <p class="text-sm mb-3 text-foreground-secondary">ERP operations overview with KPIs, status tags, and order summaries. Exercises Metric, Tag, Avatar, Progress, DashList, and Card components.</p>
          <div class="flex gap-2 flex-wrap">
            <span class="tag tag-accent">Sample Page</span>
            <span class="tag tag-muted">Dashboard</span>
          </div>
        </div>
        <div class="w-[120px] h-[120px] rounded-xl shrink-0 flex items-center justify-center max-md:w-full max-md:h-20 bg-brand-primary-subtle" style="font-size: 36px;">&#9632;</div>
      </article>
    </div>
  </div>
</section>
