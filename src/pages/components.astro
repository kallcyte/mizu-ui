---
import BaseLayout from "../layouts/BaseLayout.astro";

const components = [
  { name: "Accordion", slug: "accordion", category: "data", desc: "Expandable content panels with single and multi-item selection." },
  { name: "Alert", slug: "alert", category: "element", desc: "Feedback messaging for success, error, warning, and info states." },
  { name: "AlertDialog", slug: "alert-dialog", category: "overlay", desc: "Modal confirmation for destructive and critical actions." },
  { name: "Avatar", slug: "avatar", category: "element", desc: "User identity with image, initials, or icon in 4 sizes." },
  { name: "Avatar Group", slug: "avatar-group", category: "element", desc: "Stacked avatars with overlap and +N overflow indicator." },
  { name: "Badge", slug: "badge", category: "element", desc: "Compact count or status indicator for notifications and inline labels." },
  { name: "Breadcrumb", slug: "breadcrumb", category: "layout", desc: "Navigation component that shows the current page location within a hierarchy." },
  { name: "Button", slug: "button", category: "element", desc: "Multi-variant button with primary, accent, ghost, outline, and feedback states." },
  { name: "Card", slug: "card", category: "element", desc: "Composable card with header, content, footer, image, and spacing variants." },
  { name: "Checkbox", slug: "checkbox", category: "forms", desc: "Tri-state checkbox with indeterminate, disabled, and form integration." },
  { name: "CheckboxGroup", slug: "checkbox-group", category: "forms", desc: "Group of checkboxes with shared state, layout, and fieldset semantics." },
  { name: "Collapsible", slug: "collapsible", category: "element", desc: "Toggleable panel that shows and hides content with animated transitions." },
  { name: "Combobox", slug: "combobox", category: "forms", desc: "Searchable list input with text filtering, groups, and single or multi selection." },
  { name: "DashList", slug: "dashlist", category: "data", desc: "Definition list component for label-value pairs." },
  { name: "DataTable", slug: "data-table", category: "data", desc: "Table component for displaying and interacting with structured data." },
  { name: "Dialog", slug: "dialog", category: "overlay", desc: "Modal overlay for confirmations, forms, and detailed content." },
  { name: "Divider", slug: "divider", category: "element", desc: "Visual separator with horizontal, vertical, and labeled variants." },
  { name: "Drawer", slug: "drawer", category: "overlay", desc: "Edge-mounted panel that slides in for nav, filters, and bottom sheets." },
  { name: "DropdownMenu", slug: "dropdown-menu", category: "overlay", desc: "Contextual menu triggered by a button or element." },
  { name: "Empty", slug: "empty", category: "data", desc: "Placeholder for empty states with icon, title, description, and action." },
  { name: "Form", slug: "form", category: "forms", desc: "Validation-aware form wrapper with field-level error handling." },
  { name: "Input", slug: "input", category: "forms", desc: "Text input with label, helper text, error state, and 3 sizes." },
  { name: "Kbd", slug: "kbd", category: "element", desc: "Display keyboard shortcuts and key combinations in styled format." },
  { name: "Metric", slug: "metric", category: "data", desc: "Display component for showing statistics and KPIs." },
  { name: "NumberField", slug: "number-field", category: "forms", desc: "Numeric input with stepper buttons and formatting for decimals, currencies, and percentages." },
  { name: "Pagination", slug: "pagination", category: "navigation", desc: "Navigation component for navigating between pages of data." },
  { name: "Popover", slug: "popover", category: "overlay", desc: "Floating popup for rich content, forms, and contextual actions." },
  { name: "Progress", slug: "progress", category: "element", desc: "Linear progress bar with determinate, indeterminate, and complete states." },
  { name: "Quote", slug: "quote", category: "data", desc: "Block quotation with default and accent variants." },
  { name: "Radio", slug: "radio", category: "forms", desc: "Radio group for selecting one option from a set." },
  { name: "ScrollArea", slug: "scroll-area", category: "layout", desc: "Custom-styled scroll container with themed scrollbars." },
  { name: "Select", slug: "select", category: "forms", desc: "Dropdown select for choosing one option from a list." },
  { name: "Skeleton", slug: "skeleton", category: "element", desc: "Placeholder loading state for content that has not loaded yet." },
  { name: "Slider", slug: "slider", category: "forms", desc: "Numeric range input for selecting a value or range within a bounded interval." },
  { name: "Switch", slug: "switch", category: "forms", desc: "Toggle switch that represents boolean state with a sliding thumb." },
  { name: "Tabs", slug: "tabs", category: "layout", desc: "Layered sections of content displayed one at a time with horizontal and vertical layouts." },
  { name: "Tag", slug: "tag", category: "element", desc: "Status and category tag with 6 variants and optional close button." },
  { name: "TagsInput", slug: "tags-input", category: "forms", desc: "Multi-value text input that lets users build and remove a list of tag chips." },
  { name: "Textarea", slug: "textarea", category: "forms", desc: "Multi-line text input for longer-form content." },
  { name: "Toast", slug: "toast", category: "overlay", desc: "Auto-dismissible notification with swipe gesture and action support." },
  { name: "ToggleGroup", slug: "toggle-group", category: "forms", desc: "Segmented control for choosing one or multiple options from a set." },
  { name: "Tooltip", slug: "tooltip", category: "overlay", desc: "Contextual popup on hover or focus with directional placement and arrow." },
  { name: "Validation Patterns", slug: "validation-patterns", category: "forms", desc: "Form validation patterns using Zod schemas and the useForm composable." },
];
---

<BaseLayout>
  <section class="pt-[140px] pb-xxl">
    <div class="container">
      <h1 class="text-[48px] max-sm:text-[32px] font-extrabold tracking-tight mb-4">
        Components
      </h1>
      <p class="text-xl text-foreground-secondary max-w-[640px] mb-12">
        A small fixed set of atomic modules, kept only where they solve a concrete UI problem.
      </p>

      <div class="comp-grid">
        {components.map((c) => (
          <a
            href={`/components/${c.category}/${c.slug}`}
            class="block p-6 rounded-xl border transition-all duration-200 card-hover border-surface-muted bg-surface-base no-underline group hover:border-foreground-primary/30 hover:shadow-[0_0_0_1px_var(--color-foreground-primary)]"
          >
            <h4 class="text-[16px] font-semibold mb-1 group-hover:text-foreground-primary transition-colors">{c.name}</h4>
            <p class="text-sm text-foreground-secondary">{c.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

