---
import BaseLayout from "../layouts/BaseLayout.astro";

const components = [
  { name: "Accordion", slug: "accordion", category: "data", desc: "Expandable content panels with single and multi-item selection." },
  { name: "Alert", slug: "alert", category: "element", desc: "Feedback messaging for success, error, warning, and info states." },
  { name: "Avatar", slug: "avatar", category: "element", desc: "User identity with image, initials, or icon in 4 sizes." },
  { name: "AvatarGroup", slug: "avatar-group", category: "element", desc: "Stacked avatars with overlap and +N overflow indicator." },
  { name: "Badge", slug: "badge", category: "element", desc: "Compact count or status indicator for notifications and inline labels." },
  { name: "Banner", slug: "banner", category: "element", desc: "Top-site announcement bar for important information." },
  { name: "Breadcrumb", slug: "breadcrumb", category: "navigation", desc: "Navigation component that shows the current page location within a hierarchy." },
  { name: "Button", slug: "button", category: "element", desc: "Multi-variant button with primary, accent, ghost, outline, and feedback states." },
  { name: "Calendar", slug: "calendar", category: "element", desc: "Date picker for single dates, multiple dates, or ranges." },
  { name: "Card", slug: "card", category: "element", desc: "Composable card with header, content, footer, image, and spacing variants." },
  { name: "Carousel", slug: "carousel", category: "data", desc: "A carousel with motion and swipe built using Embla." },
  { name: "ChatMessage", slug: "chat-message", category: "chat", desc: "Display a chat message with icon, avatar, and actions." },
  { name: "ChatMessages", slug: "chat-messages", category: "chat", desc: "Display a list of chat messages for AI chat interfaces." },
  { name: "ChatPalette", slug: "chat-palette", category: "chat", desc: "Chatbot interface inside an overlay container." },
  { name: "ChatPrompt", slug: "chat-prompt", category: "chat", desc: "Enhanced textarea for submitting prompts in AI chat." },
  { name: "ChatPromptSubmit", slug: "chat-prompt-submit", category: "chat", desc: "Submit button with automatic status handling." },
  { name: "ChatReasoning", slug: "chat-reasoning", category: "chat", desc: "Collapsible AI reasoning or thinking process display." },
  { name: "ChatShimmer", slug: "chat-shimmer", category: "chat", desc: "Text shimmer animation effect for loading states." },
  { name: "ChatTool", slug: "chat-tool", category: "chat", desc: "Collapsible AI tool invocation status display." },
  { name: "Checkbox", slug: "checkbox", category: "forms", desc: "Tri-state checkbox with indeterminate, disabled, and form integration." },
  { name: "CheckboxGroup", slug: "checkbox-group", category: "forms", desc: "Group of checkboxes with shared state, layout, and fieldset semantics." },
  { name: "Chip", slug: "chip", category: "element", desc: "Small indicator badge for numeric values or states." },
  { name: "Collapsible", slug: "collapsible", category: "element", desc: "Toggleable panel that shows and hides content with animated transitions." },
  { name: "CommandPalette", slug: "command-palette", category: "navigation", desc: "Fuzzy search palette for command and item filtering." },
  { name: "ContextMenu", slug: "context-menu", category: "overlay", desc: "Right-click menu with nested items and keyboard shortcuts." },
  { name: "DashList", slug: "dashlist", category: "data", desc: "Definition list component for label-value pairs." },
  { name: "Drawer", slug: "drawer", category: "overlay", desc: "Gesture-driven panel with snap points for mobile-friendly sheets." },
  { name: "DropdownMenu", slug: "dropdown-menu", category: "overlay", desc: "Contextual menu triggered by a button click." },
  { name: "Editor", slug: "editor", category: "editor", desc: "Rich text editor based on TipTap with markdown and HTML support." },
  { name: "EditorDragHandle", slug: "editor-drag-handle", category: "editor", desc: "Draggable handle for reordering and selecting blocks." },
  { name: "EditorEmojiMenu", slug: "editor-emoji-menu", category: "editor", desc: "Emoji picker triggered by typing : for quick emoji insertion." },
  { name: "EditorMentionMenu", slug: "editor-mention-menu", category: "editor", desc: "User mention suggestions triggered by typing @ in the editor." },
  { name: "EditorSuggestionMenu", slug: "editor-suggestion-menu", category: "editor", desc: "Slash command menu for formatting and action suggestions." },
  { name: "EditorToolbar", slug: "editor-toolbar", category: "editor", desc: "Customizable toolbar with fixed, bubble, and floating layouts." },
  { name: "Empty", slug: "empty", category: "data", desc: "Placeholder for empty states with icon, title, description, and action." },
  { name: "FieldGroup", slug: "field-group", category: "forms", desc: "Group multiple form elements with shared sizing and connected borders." },
  { name: "FileUpload", slug: "file-upload", category: "forms", desc: "File upload with drag-and-drop and configurable layout." },
  { name: "FooterColumns", slug: "footer-columns", category: "navigation", desc: "Link columns for displaying structured navigation in a page footer." },
  { name: "Form", slug: "form", category: "forms", desc: "Validation-aware form wrapper with field-level error handling." },
  { name: "FormField", slug: "form-field", category: "forms", desc: "Wrapper for form elements with validation and error handling." },
  { name: "Icon", slug: "icon", category: "element", desc: "Display any icon from Iconify or another component." },
  { name: "Input", slug: "input", category: "forms", desc: "Text input with label, helper text, error state, and 3 sizes." },
  { name: "InputDate", slug: "input-date", category: "forms", desc: "Date picker input for single dates and date ranges." },
  { name: "InputMenu", slug: "input-menu", category: "forms", desc: "Autocomplete combobox with real-time suggestions." },
  { name: "InputNumber", slug: "input-number", category: "forms", desc: "Number input with stepper buttons and customizable range." },
  { name: "InputRating", slug: "input-rating", category: "forms", desc: "Star rating input with fractional steps and hover preview." },
  { name: "InputTags", slug: "input-tags", category: "forms", desc: "Token-style input for adding and removing tags." },
  { name: "InputTime", slug: "input-time", category: "forms", desc: "Time picker input with 12/24 hour format and range support." },
  { name: "Kbd", slug: "kbd", category: "element", desc: "Display keyboard shortcuts and key combinations in styled format." },
  { name: "Link", slug: "link", category: "navigation", desc: "NuxtLink wrapper with extra props for active state and external links." },
  { name: "Listbox", slug: "listbox", category: "forms", desc: "Inline selectable list with search, virtualization, and rich items." },
  { name: "Marquee", slug: "marquee", category: "data", desc: "A component to create infinite scrolling content." },
  { name: "Metric", slug: "metric", category: "data", desc: "Display component for showing statistics and KPIs." },
  { name: "Modal", slug: "modal", category: "overlay", desc: "Overlay dialog for focused tasks and confirmations." },
  { name: "NavigationMenu", slug: "navigation-menu", category: "navigation", desc: "Horizontal or vertical nav with nested items and popover menus." },
  { name: "Pagination", slug: "pagination", category: "navigation", desc: "Navigation component for navigating between pages of data." },
  { name: "PinInput", slug: "pin-input", category: "forms", desc: "OTP and PIN entry with masking and mobile autofill." },
  { name: "Popover", slug: "popover", category: "overlay", desc: "Floating card triggered by click, with title and content." },
  { name: "Progress", slug: "progress", category: "element", desc: "Linear progress bar with determinate, indeterminate, and complete states." },
  { name: "Quote", slug: "quote", category: "data", desc: "Block quotation with default and accent variants." },
  { name: "RadioGroup", slug: "radio-group", category: "forms", desc: "Select a single option from a list with card and list variants." },
  { name: "ScrollArea", slug: "scroll-area", category: "data", desc: "A flexible scroll container with virtualization support." },
  { name: "Select", slug: "select", category: "forms", desc: "Dropdown select for choosing one option from a list." },
  { name: "SelectMenu", slug: "select-menu", category: "forms", desc: "Advanced searchable dropdown with multiple selection." },
  { name: "Separator", slug: "separator", category: "element", desc: "Divider line with optional label, icon, or avatar." },
  { name: "Skeleton", slug: "skeleton", category: "element", desc: "Placeholder loading state for content that has not loaded yet." },
  { name: "Slideover", slug: "slideover", category: "overlay", desc: "Dialog panel sliding from any screen edge for detail views." },
  { name: "Slider", slug: "slider", category: "forms", desc: "Numeric range input for selecting a value or range within a bounded interval." },
  { name: "Stepper", slug: "stepper", category: "navigation", desc: "Multi-step progress indicator for forms and workflows." },
  { name: "Switch", slug: "switch", category: "forms", desc: "Toggle switch that represents boolean state with a sliding thumb." },
  { name: "Table", slug: "table", category: "data", desc: "TanStack data table with sorting, selection, and pagination." },
  { name: "Tabs", slug: "tabs", category: "navigation", desc: "Layered sections of content displayed one at a time." },
  { name: "Textarea", slug: "textarea", category: "forms", desc: "Multi-line text input for longer-form content." },
  { name: "Timeline", slug: "timeline", category: "data", desc: "Sequence of events with dates, titles, and indicators." },
  { name: "Toast", slug: "toast", category: "overlay", desc: "Non-disruptive notification with auto-dismiss and actions." },
  { name: "Tooltip", slug: "tooltip", category: "overlay", desc: "Contextual popup on hover or focus with directional placement and arrow." },
  { name: "Tree", slug: "tree", category: "data", desc: "Hierarchical tree view for navigating nested data structures." },
  { name: "User", slug: "user", category: "data", desc: "Display user information with name, description and avatar." },
  { name: "Validation Patterns", slug: "validation-patterns", category: "forms", desc: "Form validation patterns using Zod schemas and the useForm composable." },
];
---

<BaseLayout>
  <section class="pt-[140px] pb-xxl">
    <div class="container">
      <h1 class="text-[48px] max-sm:text-[32px] font-extrabold tracking-tight mb-4">
        Components
      </h1>
      <p class="text-xl text-foreground-secondary max-w-[640px] mb-12">
        A small fixed set of atomic modules, kept only where they solve a concrete UI problem.
      </p>

      <div class="comp-grid">
        {components.map((c) => (
          <a
            href={`/components/${c.category}/${c.slug}`}
            class="block p-6 rounded-xl border transition-all duration-200 card-hover border-surface-muted bg-surface-base no-underline group hover:border-foreground-primary/30 hover:shadow-[0_0_0_1px_var(--color-foreground-primary)]"
          >
            <h4 class="text-[16px] font-semibold mb-1 group-hover:text-foreground-primary transition-colors">{c.name}</h4>
            <p class="text-sm text-foreground-secondary">{c.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
