{
  "name": "@mizu/tokens",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/mizu-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./light.css": "./dist/light.css",
    "./dark.css": "./dist/dark.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./starlight.css": "./dist/starlight.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx src/build.ts && tsc",
    "dev": "tsx src/build.ts --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
