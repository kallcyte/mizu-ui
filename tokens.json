{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Mizu Design System — full token specification (DTCG format).",
  "color": {
    "brand": {
      "primary": {
        "$value": "#001C44",
        "$type": "color",
        "$description": "Strongest brand presence for hero emphasis and dark branded surfaces."
      },
      "primary-hover": {
        "$value": "#001536",
        "$type": "color",
        "$description": "Darker hover state for primary-filled buttons and nav items."
      },
      "primary-focus": {
        "$value": "#000F28",
        "$type": "color",
        "$description": "Deepest primary for focus-visible emphasis and pressed states."
      },
      "primary-subtle": {
        "$value": "#D6E4FF",
        "$type": "color",
        "$description": "Light-tinted primary surface for quiet branded backgrounds."
      },
      "secondary": {
        "$value": "#1524A9",
        "$type": "color",
        "$description": "Supporting brand blue for charts and secondary emphasis."
      },
      "secondary-hover": {
        "$value": "#101C82",
        "$type": "color",
        "$description": "Darker hover state for secondary brand fills."
      },
      "secondary-focus": {
        "$value": "#0C1561",
        "$type": "color",
        "$description": "Deepest secondary for focus-visible outlines and pressed states."
      },
      "secondary-subtle": {
        "$value": "#E1E7FF",
        "$type": "color",
        "$description": "Light surface counterpart for secondary branded backgrounds."
      },
      "accent": {
        "$value": "#007FFF",
        "$type": "color",
        "$description": "Interactive accent for links, focus states, and highlighted controls."
      },
      "accent-hover": {
        "$value": "#0066CC",
        "$type": "color",
        "$description": "Darker hover state for accent-filled buttons and links."
      },
      "accent-focus": {
        "$value": "#004C99",
        "$type": "color",
        "$description": "Deep accent for focus-visible emphasis and active-selected states."
      },
      "accent-subtle": {
        "$value": "#E0F2FE",
        "$type": "color",
        "$description": "Light accent-tinted background for info callouts and highlights."
      },
      "muted": {
        "$value": "#EDF0FF",
        "$type": "color",
        "$description": "Soft brand-tinted surface for subtle highlights and selected rows."
      },
      "neutral": {
        "$value": "#1B1B1D",
        "$type": "color",
        "$description": "Deep neutral for high-contrast text and key borders."
      }
    },
    "surface": {
      "base": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Default page and card background. Highest-contrast surface."
      },
      "subtle": {
        "$value": "#F9FAFB",
        "$type": "color",
        "$description": "Secondary surface for grouped sections and side panels."
      },
      "muted": {
        "$value": "#F3F4F6",
        "$type": "color",
        "$description": "Tertiary surface for table rows and disabled zones."
      }
    },
    "foreground": {
      "primary": {
        "$value": "#1B1B1D",
        "$type": "color",
        "$description": "Default high-emphasis text for titles and body copy."
      },
      "secondary": {
        "$value": "#4B5563",
        "$type": "color",
        "$description": "Supporting text for descriptions and metadata."
      },
      "tertiary": {
        "$value": "#9CA3AF",
        "$type": "color",
        "$description": "Low-emphasis text for placeholders and disabled content."
      },
      "inverse": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Text on dark or saturated backgrounds — preserves legibility."
      }
    },
    "feedback": {
      "success": {
        "base": { "$value": "#15803D", "$type": "color", "$description": "Primary success for confirmed positive status." },
        "hover": { "$value": "#166534", "$type": "color", "$description": "Darker hover for success-filled elements." },
        "focus": { "$value": "#14532D", "$type": "color", "$description": "Deepest success for focus-visible outlines." },
        "subtle": { "$value": "#DCFCE7", "$type": "color", "$description": "Light success background for banners." }
      },
      "error": {
        "base": { "$value": "#DC2626", "$type": "color", "$description": "Primary error for critical statuses." },
        "hover": { "$value": "#B91C1C", "$type": "color", "$description": "Darker hover for error-filled elements." },
        "focus": { "$value": "#991B1B", "$type": "color", "$description": "Deepest error for focus-visible outlines." },
        "subtle": { "$value": "#FEF2F2", "$type": "color", "$description": "Light error background for error banners." }
      },
      "warning": {
        "base": { "$value": "#D97706", "$type": "color", "$description": "Primary warning for caution states, pending indicators." },
        "hover": { "$value": "#B45309", "$type": "color", "$description": "Darker hover for warning-filled elements." },
        "focus": { "$value": "#92400E", "$type": "color", "$description": "Deepest warning for focus-visible outlines." },
        "subtle": { "$value": "#FFFBEB", "$type": "color", "$description": "Light amber background for warning banners." }
      },
      "info": {
        "base": { "$value": "#0284C7", "$type": "color", "$description": "Primary info for on-progress and processing states." },
        "hover": { "$value": "#0369A1", "$type": "color", "$description": "Darker hover for info-filled elements." },
        "focus": { "$value": "#075985", "$type": "color", "$description": "Deepest info for focus-visible outlines." },
        "subtle": { "$value": "#F0F9FF", "$type": "color", "$description": "Light sky background for info banners." }
      }
    },
    "dark": {
      "brand": {
        "primary": { "$value": "#D6E4FF", "$type": "color", "$description": "Dark mode primary — lighter for dark backgrounds." },
        "primary-hover": { "$value": "#E8F0FF", "$type": "color", "$description": "Dark mode primary hover." },
        "primary-focus": { "$value": "#BFDBFE", "$type": "color", "$description": "Dark mode primary focus." },
        "primary-subtle": { "$value": "#1E2A45", "$type": "color", "$description": "Dark mode subtle primary — dark navy tint for branded backgrounds." },
        "secondary": { "$value": "#93C5FD", "$type": "color", "$description": "Dark mode supporting brand blue." },
        "secondary-hover": { "$value": "#BFDBFE", "$type": "color", "$description": "Dark mode secondary hover." },
        "secondary-focus": { "$value": "#DBEAFE", "$type": "color", "$description": "Dark mode secondary focus." },
        "secondary-subtle": { "$value": "#1E2A3A", "$type": "color", "$description": "Dark mode secondary subtle." },
        "accent": { "$value": "#60A5FA", "$type": "color", "$description": "Dark mode accent — lighter blue for links." },
        "accent-hover": { "$value": "#93C5FD", "$type": "color", "$description": "Dark mode accent hover." },
        "accent-subtle": { "$value": "#172554", "$type": "color", "$description": "Dark mode subtle accent — dark blue tint for highlighted backgrounds." },
        "muted": { "$value": "#1E2A3A", "$type": "color", "$description": "Dark mode muted — subtle brand tint on dark." },
        "neutral": { "$value": "#F1F5F9", "$type": "color", "$description": "Dark mode deep neutral for high-contrast text." }
      },
      "surface": {
        "base": { "$value": "#0F1117", "$type": "color", "$description": "Dark mode page background." },
        "subtle": { "$value": "#161822", "$type": "color", "$description": "Dark mode secondary surface." },
        "muted": { "$value": "#1E2030", "$type": "color", "$description": "Dark mode tertiary surface." }
      },
      "foreground": {
        "primary": { "$value": "#F1F5F9", "$type": "color", "$description": "Dark mode high-emphasis text (WCAG AA on #0F1117)." },
        "secondary": { "$value": "#94A3B8", "$type": "color", "$description": "Dark mode supporting text (WCAG AA on #0F1117)." },
        "tertiary": { "$value": "#64748B", "$type": "color", "$description": "Dark mode low-emphasis text." },
        "inverse": { "$value": "#0F1117", "$type": "color", "$description": "Dark mode text on light surfaces." }
      },
      "feedback": {
        "success": {
          "base": { "$value": "#4ADE80", "$type": "color", "$description": "Dark mode success — lighter green." },
          "hover": { "$value": "#86EFAC", "$type": "color", "$description": "Dark mode success hover." },
          "focus": { "$value": "#BBF7D0", "$type": "color", "$description": "Dark mode success focus." },
          "subtle": { "$value": "#14532D", "$type": "color", "$description": "Dark mode success subtle — deep green background." }
        },
        "error": {
          "base": { "$value": "#F87171", "$type": "color", "$description": "Dark mode error — lighter red." },
          "hover": { "$value": "#FCA5A5", "$type": "color", "$description": "Dark mode error hover." },
          "focus": { "$value": "#FECACA", "$type": "color", "$description": "Dark mode error focus." },
          "subtle": { "$value": "#7F1D1D", "$type": "color", "$description": "Dark mode error subtle — deep red background." }
        },
        "warning": {
          "base": { "$value": "#FBBF24", "$type": "color", "$description": "Dark mode warning — lighter amber." },
          "hover": { "$value": "#FCD34D", "$type": "color", "$description": "Dark mode warning hover." },
          "focus": { "$value": "#FDE68A", "$type": "color", "$description": "Dark mode warning focus." },
          "subtle": { "$value": "#78350F", "$type": "color", "$description": "Dark mode warning subtle — deep amber background." }
        },
        "info": {
          "base": { "$value": "#38BDF8", "$type": "color", "$description": "Dark mode info — lighter sky." },
          "hover": { "$value": "#7DD3FC", "$type": "color", "$description": "Dark mode info hover." },
          "focus": { "$value": "#BAE6FD", "$type": "color", "$description": "Dark mode info focus." },
          "subtle": { "$value": "#1E3A5F", "$type": "color", "$description": "Dark mode info subtle — deep sky background." }
        }
      }
    }
  },
  "fontFamily": {
    "sans": {
      "$value": ["DM Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
      "$type": "fontFamily",
      "$description": "Primary sans-serif typeface for UI and headings."
    },
    "mono": {
      "$value": ["JetBrains Mono", "SF Mono", "Fira Code", "Cascadia Code", "monospace"],
      "$type": "fontFamily",
      "$description": "Monospace typeface for code and technical content."
    },
    "serif": {
      "$value": ["Noto Serif", "Yu Mincho", "YuMincho", "MS PMincho", "SimSun", "Songti SC", "serif"],
      "$type": "fontFamily",
      "$description": "Serif typeface for editorial and long-form content. Includes CJK (Japanese & Chinese) system font fallbacks."
    }
  },
  "fontSize": {
    "display": { "$value": "36px", "$type": "dimension", "$description": "Largest heading size for hero and splash text." },
    "h1": { "$value": "24px", "$type": "dimension", "$description": "Primary section heading." },
    "h2": { "$value": "18px", "$type": "dimension", "$description": "Secondary section heading." },
    "h3": { "$value": "15px", "$type": "dimension", "$description": "Tertiary heading / card title." },
    "body": { "$value": "15px", "$type": "dimension", "$description": "Default body text." },
    "caption": { "$value": "13px", "$type": "dimension", "$description": "Figure notes and annotation text." },
    "label": { "$value": "11px", "$type": "dimension", "$description": "Small labels and metadata." }
  },
  "fontWeight": {
    "regular": { "$value": 400, "$type": "number", "$description": "Default body weight." },
    "medium": { "$value": 500, "$type": "number", "$description": "Medium emphasis." },
    "semibold": { "$value": 600, "$type": "number", "$description": "Subheading weight." },
    "bold": { "$value": 700, "$type": "number", "$description": "Heading weight." },
    "extrabold": { "$value": 800, "$type": "number", "$description": "Hero / display weight." }
  },
  "lineHeight": {
    "display": { "$value": 1.1, "$type": "number", "$description": "Extra tight for display text." },
    "h1": { "$value": 1.2, "$type": "number" },
    "h2": { "$value": 1.25, "$type": "number" },
    "h3": { "$value": 1.3, "$type": "number" },
    "body": { "$value": 1.6, "$type": "number", "$description": "Extended reading body." },
    "caption": { "$value": 1.45, "$type": "number" },
    "label": { "$value": 1.35, "$type": "number" },
    "tight": { "$value": 1.15, "$type": "number", "$description": "Tight leading for headings." },
    "comfortable": { "$value": 1.4, "$type": "number", "$description": "Comfortable reading." },
    "reading": { "$value": 1.6, "$type": "number", "$description": "Extended reading body." }
  },
  "letterSpacing": {
    "tight": { "$value": "-0.03em", "$type": "dimension", "$description": "Tight tracking for display." },
    "snug": { "$value": "-0.02em", "$type": "dimension", "$description": "Snug tracking for headings." },
    "wide": { "$value": "0.05em", "$type": "dimension", "$description": "Wide tracking for uppercase labels." },
    "wider": { "$value": "0.06em", "$type": "dimension", "$description": "Extra wide for all-caps metadata." }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension", "$description": "Inline elements, tight icons." },
    "sm": { "$value": "6px", "$type": "dimension", "$description": "Tag padding, dense layout." },
    "md": { "$value": "12px", "$type": "dimension", "$description": "Component internals, button padding." },
    "lg": { "$value": "24px", "$type": "dimension", "$description": "Between components, card padding." },
    "xl": { "$value": "48px", "$type": "dimension", "$description": "Section title margins, page gutters." },
    "xxl": { "$value": "80px", "$type": "dimension", "$description": "Between major sections." },
    "section-y": { "$value": "80px", "$type": "dimension", "$description": "Default section vertical padding." },
    "container": { "$value": "1040px", "$type": "dimension", "$description": "Max content width." },
    "nav-h": { "$value": "56px", "$type": "dimension", "$description": "Navigation bar height." }
  },
  "borderRadius": {
    "tight": { "$value": "4px", "$type": "dimension", "$description": "Code inline, tight corners." },
    "default": { "$value": "8px", "$type": "dimension", "$description": "Default button, input." },
    "card": { "$value": "12px", "$type": "dimension", "$description": "Card, container." },
    "feature": { "$value": "16px", "$type": "dimension", "$description": "Feature card, hero." },
    "large": { "$value": "24px", "$type": "dimension", "$description": "Large container." },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Pill / fully rounded." }
  },
  "shadow": {
    "ring": {
      "$value": "0 0 0 1px #F3F4F6",
      "$type": "shadow",
      "$description": "Border ring for buttons and card hover states."
    },
    "whisper": {
      "$value": "0 2px 16px rgba(0,0,0,0.04)",
      "$type": "shadow",
      "$description": "Subtle elevation for cards and menus."
    },
    "dark": {
      "ring": {
        "$value": "0 0 0 1px #1E2030",
        "$type": "shadow",
        "$description": "Dark mode border ring for buttons and card hover states."
      },
      "whisper": {
        "$value": "0 2px 16px rgba(0,0,0,0.24)",
        "$type": "shadow",
        "$description": "Dark mode subtle elevation for cards and menus."
      }
    }
  },
  "sizing": {
    "color-swatch-h": { "$value": "80px", "$type": "dimension", "$description": "Color swatch preview height." },
    "card-visual": { "$value": "120px", "$type": "dimension", "$description": "Card visual block dimension." },
    "icon-inline": { "$value": "20px", "$type": "dimension", "$description": "Inline icon / swatch size." },
    "hero-gradient": { "$value": "600px", "$type": "dimension", "$description": "Hero decorative gradient dimension." }
  },
  "zIndex": {
    "nav": { "$value": 100, "$type": "number", "$description": "Navigation bar stack order." }
  },
  "duration": {
    "fast": { "$value": "200ms", "$type": "duration", "$description": "Hover and micro-interactions." },
    "normal": { "$value": "300ms", "$type": "duration", "$description": "Accordion and panel transitions." }
  },
  "breakpoint": {
    "sm": { "$value": "640px", "$type": "dimension", "$description": "Small / tablet portrait." },
    "md": { "$value": "768px", "$type": "dimension", "$description": "Medium / tablet landscape." },
    "lg": { "$value": "1024px", "$type": "dimension", "$description": "Large / desktop." },
    "xl": { "$value": "1280px", "$type": "dimension", "$description": "Extra large / wide desktop." }
  }
}
